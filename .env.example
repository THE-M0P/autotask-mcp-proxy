# ================= identity proxy =================
PORT=8080
# In docker-compose this is overridden to http://autotask-mcp:8080
UPSTREAM_URL=http://127.0.0.1:8081

# ============ Autotask shared keycard (the "API user") ============
AUTOTASK_USERNAME=api-user@example.com
AUTOTASK_SECRET=replace-me
AUTOTASK_INTEGRATION_CODE=replace-me

# ============ S2S signing (must equal autotask-mcp's CONDUIT_S2S_SECRET) ============
# generate: openssl rand -hex 32
# NOTE: the proxy refuses to start if this is empty or a known placeholder
# (changeme, replace-me, …). Set a real value, or use the dev flag below.
S2S_SECRET=replace-me

# ============ local development only ============
# 1 → allow starting with an EMPTY S2S_SECRET (S2S signing uses an empty key).
#     A placeholder secret is never bypassed. Do not use in production.
PROXY_ALLOW_INSECURE_DEV=0

# ============ Entra token validation ============
# Your organisation's Entra tenant ID
TENANT_ID=00000000-0000-0000-0000-000000000000
# Client ID of the new "Autotask-MCP resource app" Entra registration
AUDIENCE=replace-me-client-id
# Delegated scope that registration exposes
REQUIRED_SCOPE=autotask_access

# ============ optional: email → Autotask resource ID overrides ============
# For edge cases only (aliases, resources without email). JSON object.
OVERRIDE_MAP={}

# ============ read-only surface (CIPP-style pilot phase) ============
# true  → write tools (create_*/update_*/delete_*/raw_request) are rejected
#         with a clear error; reads work normally. Good for pilot phase 1.
# false → full surface (pilot phase 2, once trust is established)
READ_ONLY=true
